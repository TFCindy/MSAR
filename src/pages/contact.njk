---
layout: layouts/base.njk
permalink: /contact/
title: Contact
description: "Get in touch with MSAR about membership, events, partnerships or media — email, phone, WhatsApp or the contact form."
---
{%- from "partials/macros.njk" import icon, pageHero -%}
{{ pageHero("Contact", "Let's <em>talk.</em>", "Questions about membership, an event or a partnership? Reach out — we usually reply within a few days.", [{label: "Contact"}]) }}

<section class="section section--paper">
  <div class="container split split--top">
    <div>
      <p class="eyebrow">Reach us directly</p>
      <ul class="contact-list mt-m">
        <li><a class="contact-item" href="mailto:{{ site.email }}"><span class="ico">{{ icon('mail') }}</span><span><small>Email</small><strong>{{ site.email }}</strong></span></a></li>
        <li><a class="contact-item" href="tel:{{ site.phoneHref }}"><span class="ico">{{ icon('phone') }}</span><span><small>Phone</small><strong>{{ site.phone }}</strong></span></a></li>
        <li><a class="contact-item" href="https://wa.me/{{ site.whatsapp }}" target="_blank" rel="noopener noreferrer"><span class="ico">{{ icon('whatsapp', 'icon--fill') }}</span><span><small>WhatsApp</small><strong>Message MSAR</strong></span></a></li>
        <li><a class="contact-item" href="{{ site.socials[0].url }}" target="_blank" rel="noopener noreferrer"><span class="ico">{{ icon('linkedin', 'icon--fill') }}</span><span><small>LinkedIn</small><strong>MSAR Rwanda</strong></span></a></li>
        <li><a class="contact-item" href="{{ site.mapUrl }}" target="_blank" rel="noopener noreferrer"><span class="ico">{{ icon('pin') }}</span><span><small>Find us</small><strong>University of Rwanda — CST, Nyarugenge Campus, Kigali</strong></span></a></li>
      </ul>
    </div>
    <div class="form-card" data-form-wrap>
      <h2 class="h3">Send a message</h2>
      <form class="mt-m" data-supabase-table="contact_messages" data-sb-url="{{ site.supabase.url }}" data-sb-key="{{ site.supabase.publishableKey }}" data-fallback-email="{{ site.email }}" novalidate>
        <div class="form-grid">
          <div class="field"><label for="c-name">Name <span class="req" aria-hidden="true">*</span></label><input id="c-name" type="text" name="name" autocomplete="name" required></div>
          <div class="field"><label for="c-email">Email <span class="req" aria-hidden="true">*</span></label><input id="c-email" type="email" name="email" autocomplete="email" required></div>
          <div class="field field--full"><label for="c-subject">Topic <span class="req" aria-hidden="true">*</span></label>
            <select id="c-subject" name="subject" required><option value="">Choose a topic…</option><option value="Membership">Membership</option><option value="Events">Events &amp; registration</option><option value="Partnership">Partnership or collaboration</option><option value="Training">Training request</option><option value="Media">Media</option><option value="Other">Something else</option></select></div>
          <div class="field field--full"><label for="c-msg">Message <span class="req" aria-hidden="true">*</span></label><textarea id="c-msg" name="message" required></textarea></div>
          <div class="visually-hidden" aria-hidden="true"><label for="c-company">Leave this field empty</label><input id="c-company" type="text" name="company" tabindex="-1" autocomplete="off"></div>
        </div>
        <button type="submit" class="btn btn--block mt-m">Send message {{ icon('arrow', 'icon--arrow') }}</button>
        <div class="form-status" role="alert" hidden></div>
      </form>
      <div class="form-success" hidden>
        <div class="ok">{{ icon('check') }}</div>
        <h3 class="h3">Message sent</h3>
        <p class="muted mt-s">Thanks for reaching out — the MSAR team will get back to you soon.</p>
      </div>
    </div>
  </div>
</section>
<script>
  (function () { var t = new URLSearchParams(location.search).get('topic'); var s = document.getElementById('c-subject');
    if (t && s) { var m = { partnership: 'Partnership', membership: 'Membership', events: 'Events', training: 'Training', media: 'Media' }[t.toLowerCase()]; if (m) s.value = m; } })();
</script>
