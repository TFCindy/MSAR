<!doctype html>
{%- from "partials/macros.njk" import icon -%}
{%- set pageTitle = (title + " | MSAR Rwanda") if title and not isHome else ("MSAR Rwanda | " + site.fullName) -%}
{%- set pageDesc = description or summary or site.description -%}
{%- set shareImage = ogImage or cover or site.ogImage -%}
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc | stripHtml | truncate(165) }}">
<link rel="canonical" href="{{ page.url | absoluteUrl(site.url) }}">
<meta name="theme-color" content="#1e3a66">
<meta name="robots" content="{{ 'noindex, follow' if noindex else 'index, follow, max-image-preview:large' }}">
<meta name="author" content="{{ site.fullName }}">
<meta name="keywords" content="MSAR, MSAR Rwanda, Mathematics and Statistics Students' Association of Rwanda, University of Rwanda, UR-CST, statistics students Rwanda, data skills training Rwanda, Power BI training Kigali, KoboToolbox training, QGIS, data science students Rwanda">
<meta name="google-site-verification" content="Pkn2kWtcAAblzu0n_KGeGfn92EVPQPT6pmPl1KHay5c">
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDesc | stripHtml | truncate(200) }}">
<meta property="og:url" content="{{ page.url | absoluteUrl(site.url) }}">
<meta property="og:image" content="{{ shareImage | absoluteUrl(site.url) }}">
<meta property="og:image:alt" content="{{ ogImageAlt or (site.name + ' — ' + (title or site.fullName)) }}">
<meta property="og:locale" content="en_GB">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDesc | stripHtml | truncate(200) }}">
<meta name="twitter:image" content="{{ shareImage | absoluteUrl(site.url) }}">
<link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Figtree:ital,wght@0,400..700;1,400&family=Instrument+Serif:ital@1&family=JetBrains+Mono:wght@500&display=swap">
<link rel="stylesheet" href="/assets/css/main.css?v={{ build.version }}">
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "EducationalOrganization"],
      "@id": site.url + "/#organization",
      "name": site.fullName,
      "alternateName": ["MSAR", "MSAR Rwanda"],
      "url": site.url,
      "logo": site.url + "/images/brand/msar-badge.png",
      "image": site.ogImage | absoluteUrl(site.url),
      "description": site.description,
      "email": site.email,
      "telephone": site.phoneHref,
      "foundingDate": site.founded,
      "slogan": site.tagline,
      "sameAs": [site.socials[0].url],
      "parentOrganization": { "@type": "CollegeOrUniversity", "name": "University of Rwanda", "url": "https://ur.ac.rw" },
      "address": { "@type": "PostalAddress", "streetAddress": "University of Rwanda, College of Science and Technology, Nyarugenge Campus", "addressLocality": "Kigali", "addressCountry": "RW" },
      "areaServed": "Rwanda",
      "knowsAbout": ["Mathematics", "Statistics", "Data science", "Data analysis", "Power BI", "KoboToolbox", "Excel", "QGIS", "Google Earth Engine", "Python"]
    },
    {
      "@type": "WebSite",
      "@id": site.url + "/#website",
      "url": site.url,
      "name": "MSAR Rwanda",
      "alternateName": site.fullName,
      "publisher": { "@id": site.url + "/#organization" },
      "inLanguage": "en"
    }
  ]
} | json | safe }}</script>
{%- if page.url != "/" and page.url.endsWith("/") %}
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": page.url | breadcrumbs(title, site.url)
} | json | safe }}</script>
{%- endif %}
{% block head %}{% endblock %}
</head>
<body class="{{ bodyClass }}">
<a class="skip-link" href="#main">Skip to content</a>
{% include "partials/icons.njk" %}


{% include "partials/header.njk" %}

<main id="main" tabindex="-1">
{{ content | safe }}
</main>

{% include "partials/footer.njk" %}

<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
  <div class="lb-top"><span class="lb-count" aria-live="polite"></span><button type="button" class="lb-btn lb-close" aria-label="Close photo viewer">{{ icon('close') }}</button></div>
  <div class="lb-stage">
    <img alt="">
    <button type="button" class="lb-btn lb-prev" aria-label="Previous photo">{{ icon('chev-left') }}</button>
    <button type="button" class="lb-btn lb-next" aria-label="Next photo">{{ icon('chev-right') }}</button>
  </div>
  <p class="lb-cap"></p>
</div>

<aside aria-label="Quick contact"><a href="https://wa.me/{{ site.whatsapp }}" class="wa-float" target="_blank" rel="noopener noreferrer" aria-label="Message MSAR on WhatsApp">{{ icon('whatsapp', 'icon--fill') }}</a></aside>
<script src="/assets/js/main.js?v={{ build.version }}" defer></script>
{% block scripts %}{% endblock %}
</body>
</html>
